model Group {
  id             String           @id @default(cuid())
  ownerId        Int              @unique
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  UserGroup      UserGroup[]
  owner          User             @relation(fields: [ownerId], references: [id])
  WorkspaceGroup WorkspaceGroup[]
}
