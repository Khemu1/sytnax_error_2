model Survey {
  id          String             @id @default(cuid())
  workspaceId String             @unique
  name        String
  openInterval String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  submissions SurveySubmission[]
  questions   Question[]
}
