generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("SUBA")
    // url      = env("DATABASE_URL_ACC")

  // directUrl = env("SUB_DIRECT")
    directUrl = env("SUB_DIRECT")
}
