model Workspace {
  id             String           @id @default(cuid())
  userId         Int
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  surveys        Survey[]
  ownerId        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  WorkspaceGroup WorkspaceGroup[]
}
